{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lilypond",
            "type": "process",
            "command": "${workspaceFolder}/.prog/lilypond-2.26.0/bin/lilypond",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build"
        },
        {
            "label": "Save",
            "type": "shell",
            "command": "${workspaceFolder}/.prog/save.py",
            "group": "build"
        },
        {
            "label": "New",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}${pathSeparator}.prog${pathSeparator}new.py"
            ],
            "group": "build"
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "${workspaceFolder}/.prog/installer.py",
            "group": "build"
        },
        {
            "label": "Frescobaldi",
            "type": "process",
            "command": "frescobaldi",
            "args": [
                "${file}"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": "build"
        },
        {
            "label": "Timidity++",
            "type": "shell",
            "command": "timidity",
            "args": [
                "${fileDirname}/${fileBasenameNoExtension}.midi"
            ],
            "group": "build"
        },
        {
            "label": "Synchroniser .utils/",
            "type": "shell",
            "command": "cp",
            "args": [
                "${workspaceFolder}/.utils/*",
                "${workspaceFolder}/.prog/lilypond-2.26.0/share/lilypond/2.26.0/ly/"
            ],
            "group": "build"
        }
    ]
}